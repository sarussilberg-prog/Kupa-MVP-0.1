{
    "name": "cost-share-app",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "clean": "turbo run clean",
        "mobile": "cd apps/mobile && npm start",
        "server": "cd apps/server && npm run dev"
    },
    "devDependencies": {
        "turbo": "^1.13.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "overrides": {
        "react": "19.1.0"
    }
}